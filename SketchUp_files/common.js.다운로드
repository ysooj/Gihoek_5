BY,CCqBhB,mCACE,sEAAA,CACA,aAAA,CACA,WAAA,CACA,eAAA,CAEA,0BANF,mCAOI,aAAA,CACA,WAAA,CACA,eAAA,CAAA,CAIJ,wBACE,aAAA,CACA,qBAAA,CAGF,mCACE,qEAAA,CACA,yBAAA,CACA,yBAAA,CAEA,0BALF,mCAMI,aAAA,CACA,WAAA,CACA,eAAA,CACA,cAAA,CACA,cAAA,CAAA,CAIJ,0BACE,aAAA,CACA,qBAAA,CAGF,iBFuJI,8CEtJyB,CFuJzB,4CEvJyB,CFwJzB,iDExJyB,CF0J3B,yCE1J2B,CF+J3B,0BAAA,CACA,oBE/J4B,CFgK5B,wBEhK4B,CFiK5B,gBEjK4B,CAE5B,kBAAA,CACA,aDhEc,CCiEd,YAAA,CACA,kBAAA,CACA,cAAA,CACA,gBAAA,CACA,WAAA,CACA,oBAAA,CACA,cAAA,CACA,aAAA,CACA,WAAA,CAEA,eAAA,CACA,WAAA,CACA,uFAAA,CAGA,sCACE,kBAAA,CACA,eAAA,CACA,sBAAA,CAKF,yBADF,wCAEI,WAAA,CACA,cAAA,CACA,YAAA,CACA,WAAA,CACA,WAAA,CAAA,CAKF,0BADF,2BAGI,WAAA,CACA,cAAA,CACA,eAAA,CACA,WAAA,CACA,WAAA,CAAA,CAIJ,gCACE,cAAA,CACA,wBD7Gc,CCgHhB,eACE,aAAA,CACA,kBAAA,CACA,aDpHc,CCqHd,YAAA,CACA,kBAAA,CACA,cAAA,CACA,gBAAA,CACA,WAAA,CACA,sBAAA,CACA,cAAA,CAEA,mCAEE,kBAAA,CACA,eAAA,CACA,sBAAA,CACA,yBAAA,CAEA,aAAA,CAEA,0BATF,mCAWI,cAAA,CAAA,CAIJ,oCACE,cAAA,CAEA,0CACE,wBD/IU,CCmJd,8BACE,aDtIS,CC0Ib,0BACE,gHAAA,CAEA,kBAAA,CACA,cAAA,CAEA,0BANF,0BAQI,aAAA,CACA,WAAA,CACA,eAAA,CACA,kBAAA,CACA,cAAA,CACA,eAAA,CAAA,CAIJ,4BACE,aAAA,CACA,gBAAA",sourcesContent:["// Copyright 2018 - 2020 Trimble Inc. All Rights Reserved.\r\n\r\n@import 'constants';\r\n@import 'color';\r\n\r\n// Replaces Compass appearance.\r\n@mixin appearance($appearance) {\r\n  -moz-appearance: $appearance;\r\n  -webkit-appearance: $appearance;\r\n  appearance: $appearance;\r\n}\r\n\r\n//Six standardized text styles to be used everywhere\r\n\r\n//Top page headers on home page / modals\r\n@mixin h1-text {\r\n  color: $col_blue;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  letter-spacing: 1px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n//Title on cards, folders, projects\r\n@mixin h2-text {\r\n  color: $col_gray_10;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.85px;\r\n}\r\n\r\n//Panels header\r\n@mixin h3-text {\r\n  color: $col_trimble_blue;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Section header, accordions\r\n@mixin h4-text {\r\n  color: $col_gray_10;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Sub header\r\n@mixin h5-text {\r\n  color: $col_gray_9;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Everywhere else\r\n@mixin standard-text {\r\n  color: $col_gray_9;\r\n  font-size: 9pt;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.modus-text {\r\n  @include standard-text();\r\n\r\n  h1 {\r\n    @include h1-text();\r\n  }\r\n\r\n  h2 {\r\n    @include h2-text();\r\n  }\r\n\r\n  h3 {\r\n    @include h3-text();\r\n  }\r\n\r\n  h4 {\r\n    @include h4-text();\r\n  }\r\n\r\n  h5 {\r\n    @include h5-text();\r\n  }\r\n}\r\n\r\n@mixin active-input-text {\r\n  font-weight: normal;\r\n  font-size: 12px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_black;\r\n}\r\n\r\n@mixin label-badge-text {\r\n  font-weight: bold;\r\n  font-size: 10px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_gray_6;\r\n}\r\n\r\n@mixin modus-input-box($active-sel, $invalid-sel, $disabled-sel) {\r\n  border-bottom: 1px solid $col_gray_6;\r\n  border-radius: 2px;\r\n  border: 1px solid $col_gray_0;\r\n  outline: 0;\r\n  padding-top: 1px;\r\n  padding-bottom: 1px;\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n\r\n  @include active-input-text;\r\n\r\n  &::placeholder {\r\n    color: $col_gray_2;\r\n    opacity: 1;\r\n  }\r\n\r\n  &:focus,\r\n  &#{$active-sel} {\r\n    border-bottom: 2px solid $col_blue_light;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$invalid-sel} {\r\n    border-bottom: 2px solid $col_red;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$disabled-sel} {\r\n    background-color: $col_gray_0;\r\n  }\r\n}\r\n\r\n// Standard box shadow that is offset to right and down.\r\n@mixin box-shadow-right-down {\r\n  box-shadow: 2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset to left and down.\r\n@mixin box-shadow-left-down {\r\n  box-shadow: -2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset down only.\r\n@mixin box-shadow-down {\r\n  box-shadow: 2px 2px 5px 0 $drop-shadow-color;\r\n}\r\n\r\n// Vertically centers an element.\r\n// http://codepen.io/sebastianekstrom/pen/kzEhe\r\n@mixin vertical-align($position: relative) {\r\n  position: $position;\r\n  top: 50%;\r\n  -webkit-transform: translateY(-50%);\r\n  -ms-transform: translateY(-50%);\r\n  transform: translateY(-50%);\r\n}\r\n\r\n// Defines the border we use as a hover highlight effect.\r\n@mixin hover-higlight-borders {\r\n  border: 1px solid black;\r\n}\r\n\r\n// Adds a border transition to be used in conjunction with\r\n// hover-higlight-borders.\r\n@mixin hover-higlight-transition {\r\n  @include transition(border 200ms ease);\r\n}\r\n\r\n// This is a helper for hover-higlight-borders. If adding a hover border will\r\n// increase the overall height of an element (i.e. it doesn't have any borders\r\n// normally), we can use these fake borders that blend in to the background\r\n// color so that adding a hover border won't cause height changes.\r\n@mixin hover-higlight-decoy-borders($color) {\r\n  border: 1px solid $color;\r\n}\r\n\r\n@mixin non-draggable {\r\n  user-drag: none;\r\n  -webkit-user-drag: none;\r\n}\r\n\r\n@mixin default-border {\r\n  border: 1px solid $col_gray_2;\r\n}\r\n\r\n// Replaces Compass input-placeholder.\r\n@mixin input-placeholder {\r\n  &:-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &:-ms-input-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-webkit-input-placeholder {\r\n    @content;\r\n  }\r\n}\r\n\r\n// Replaces Compass opacity.\r\n@mixin opacity($opacity) {\r\n  @if $opacity == 1 {\r\n    filter: unquote('progid:DXImageTransform.Microsoft.Alpha(enabled=false)');\r\n  } @else {\r\n    filter: unquote(\r\n      'progid:DXImageTransform.Microsoft.Alpha(Opacity=#{round($opacity * 100)})'\r\n    );\r\n  }\r\n\r\n  opacity: $opacity;\r\n}\r\n\r\n@mixin spin {\r\n  animation: spin 2s linear infinite;\r\n}\r\n\r\n// Replaces Compass transform.\r\n// Note that this does not support 3D transforms like the compass rule.\r\n@mixin transform($transform) {\r\n  -moz-transform: $transform;\r\n  -ms-transform: $transform;\r\n  -webkit-transform: $transform;\r\n  transform: $transform;\r\n}\r\n\r\n// Replaces Compass transition.\r\n@mixin transition($transition) {\r\n  @if nth($transition, 1) == transform {\r\n    -moz-transition: #{'-moz-' + $transition};\r\n    -o-transition: #{'-o-' + $transition};\r\n    -webkit-transition: #{'-webkit-' + $transition};\r\n  } @else {\r\n    -moz-transition: $transition;\r\n    -o-transition: $transition;\r\n    -webkit-transition: $transition;\r\n  }\r\n  transition: $transition;\r\n}\r\n\r\n// Replaces Compass user-select.\r\n@mixin user-select($select) {\r\n  -moz-user-select: #{'-moz-' + $select};\r\n  -ms-user-select: $select;\r\n  -webkit-user-select: $select;\r\n  user-select: $select;\r\n}\r\n\r\n@mixin disabled-filter {\r\n  // Universal icon color filter for $col_gray_4 (#90939f)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(64%) sepia(19%) saturate(174%)\r\n    hue-rotate(191deg) brightness(89%) contrast(85%);\r\n}\r\n\r\n@mixin hover-filter {\r\n  // Universal icon color filter for $col_blue_electric (#009ad9)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(66%) sepia(83%) saturate(5968%)\r\n    hue-rotate(171deg) brightness(97%) contrast(101%);\r\n}\r\n\r\n@mixin blue-filter {\r\n  // Universal icon color filter for $col_blue || $col_trimble_blue (#0063A3)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(17%) sepia(42%) saturate(7267%)\r\n    hue-rotate(190deg) brightness(95%) contrast(101%);\r\n}\r\n\r\n@mixin no_scrollbar {\r\n  // Disables / hides a scrollbar in a container where one would appear\r\n  scrollbar-width: none;\r\n  &::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n}\r\n\r\n@mixin multiline-text-overflow-ellipsis($lines) {\r\n  // Normally webkit prefixes would be of concern but these are actually widely supported.\r\n  // https://caniuse.com/?search=line-clamp\r\n\r\n  display: block; /* Fallback for non-webkit */\r\n  display: -webkit-box;\r\n  line-clamp: $lines;\r\n  -webkit-line-clamp: $lines;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  word-break: break-word;\r\n  white-space: normal;\r\n}\r\n\r\n@mixin linkshare-button-base {\r\n  // Common styles for buttons in the link sharing dialog.\r\n  height: 44px;\r\n  padding: 0 12px;\r\n  border-radius: 4px;\r\n  font-family: 'Open Sans';\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  line-height: 150%;\r\n  user-select: none;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  box-sizing: border-box;\r\n\r\n  width: 120px;\r\n  text-align: center;\r\n}\r\n\r\n// Takes a color and applies an opacity value to it\r\n// Returns a rgba() color string\r\n// @param {string} $color - The original color (hex, rgb, or rgba)\r\n// @param {number} $opacity - Opacity value between 0 and 1\r\n// @return {string} - rgba color with applied opacity\r\n@function apply-opacity($color, $opacity) {\r\n  @return rgba($color, $opacity);\r\n}\r\n","/**\r\n * A color palette for the Trimble Modus Design System.\r\n *\r\n * Copyright 2022 Trimble Inc.\r\n */\r\n\r\n// GREEN\r\n$col_green: #1e8a44;\r\n$col_green_light: #4ea646;\r\n$col_green_dark: #006638;\r\n$col_green_pale: #e0eccf;\r\n\r\n// RED\r\n$col_red: #da212c;\r\n$col_red_light: #e86363;\r\n$col_red_dark: #ab1f26;\r\n$col_red_pale: #fbd4d7;\r\n\r\n// YELLOW\r\n$col_yellow: #fbad26;\r\n$col_yellow_light: #fec157;\r\n$col_yellow_dark: #e49325;\r\n$col_yellow_pale: #fff5e4;\r\n\r\n// BLUE\r\n$col_blue: #0063a3;\r\n$col_blue_mid: #005f9e;\r\n$col_blue_light: #217cbb;\r\n$col_blue_dark: #0e416c;\r\n$col_blue_pale: #dcedf9;\r\n\r\n// NEUTRAL\r\n$col_white: #ffffff;\r\n\r\n// Off-white alternatives.\r\n$col_gray_light: #f1f1f6;\r\n$col_gray_ipad: #ebebeb;\r\n\r\n// Gray ordinal scale.\r\n$col_gray_0: #e0e1e9;\r\n$col_gray_1: #cbcdd6;\r\n$col_gray_2: #b7b9c3;\r\n$col_gray_3: #a3a6b1;\r\n$col_gray_4: #90939f;\r\n$col_gray_5: #7d808d;\r\n$col_gray_6: #6a6e79;\r\n$col_gray_7: #585c65;\r\n$col_gray_8: #464b52;\r\n$col_gray_9: #353a40;\r\n$col_gray_10: #171c1e;\r\n\r\n$col_typography_body: #363545;\r\n\r\n$col_black: #000000;\r\n\r\n// Primary Trimble brand colors.\r\n$col_trimble_blue_dark: #004f83;\r\n$col_trimble_blue: $col_blue;\r\n\r\n$col_trimble_yellow: $col_yellow;\r\n$col_trimble_gray: #252a2e;\r\n\r\n// Brand accents where dark green and dark red are unavoidable.\r\n$col_trimble_green: #349c44;\r\n$col_trimble_red: #b44e2a;\r\n","\r\n@use '@sass/color';\r\n@use '@sass/constants';\r\n@use '@sass/mixins';\r\n@use '@sass/shadow';\r\n@use '@sass/zindex';\r\n\r\n$hover-color: color.$col_blue_pale;\r\n\r\n.container {\r\n  @include shadow.shadow_southeast;\r\n\r\n  align-items: center;\r\n  background-color: color.$background_color;\r\n  display: flex;\r\n  flex-direction: row;\r\n  height: v-bind(HOMEBAR_HEIGHT_PX);\r\n  left: 0;\r\n  outline: none;\r\n  position: fixed;\r\n  top: 0;\r\n  z-index: zindex.$z-index-home-bar;\r\n  max-width: calc(100% - v-bind(RIGHT_SIDEBAR_WIDTH_WITH_SCROLLBAR_PX));\r\n  overflow: hidden;\r\n}\r\n\r\n.container-presentation {\r\n  min-width: 88px;\r\n}\r\n\r\n.container-shrinkable {\r\n  transition: min-width 0.3s ease, gap 0.3s ease;\r\n  gap: 0px;\r\n\r\n  @media (max-width: 1000px) {\r\n    gap: 2px;\r\n    min-width: 220px;\r\n    overflow: hidden;\r\n  }\r\n}\r\n\r\n.action-button {\r\n  height: 100%;\r\n  flex-shrink: 0;\r\n\r\n  &:hover {\r\n    background-color: $hover-color;\r\n  }\r\n}\r\n\r\n.action-button-shrinkable {\r\n  transition: flex-grow 0.