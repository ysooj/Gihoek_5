\r\n  z-index: zindex.$z-index-loading-screen;\r\n  display: flex;\r\n  flex-flow: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: color.$col_white;\r\n}\r\n\r\n.loading-message {\r\n  font-weight: 600;\r\n  font-size: 20px;\r\n  line-height: 27px;\r\n  user-select: none;\r\n\r\n  padding-top: 51px;\r\n  padding-bottom: 51px;\r\n}\r\n\r\n.tmyk-message-container {\r\n  width: 476px; // - 24px padding left and right\r\n  height: 64px; // - 24px padding top and bottom\r\n  border-radius: 10px;\r\n  background-color: color.$col_blue_dark;\r\n  display: flex;\r\n  flex-flow: row nowrap;\r\n  align-items: center;\r\n\r\n  padding: 12px;\r\n  gap: 24px;\r\n\r\n  .tmyk-message-text {\r\n    color: color.$col_white;\r\n    font-size: 14px;\r\n    line-height: 16px;\r\n    user-select: none;\r\n\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n  }\r\n\r\n  .tmyk-message-icon {\r\n    background-color: color.$col_gray_light;\r\n    width: 56px;\r\n    height: 56px;\r\n    border-radius: 50%;\r\n    flex-shrink: 0;\r\n\r\n    // to center the svg\r\n    display: flex;\r\n    flex-flow: row nowrap;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    .tmyk-message-icon-svg {\r\n      width: 32px;\r\n      height: 32px;\r\n    }\r\n  }\r\n}\r\n\r\n.loading-progress-overlay {\r\n  position: absolute;\r\n  z-index: zindex.$z-index-loading-screen + 1;\r\n  font-size: 10px;\r\n  width: $width;\r\n  height: $height;\r\n  background-color: color.$col_white;\r\n  opacity: 0.5;\r\n  transform-origin: top;\r\n  will-change: transform;\r\n}\r\n\r\n/*\r\n  * This animates the SketchUp logo by moving blue and white svgs and divs\r\n  * around in 3D space. Critically, this must be \"off main thread animation\" so\r\n  * that it won't hang while C++ is blocking. It is a bit tricky to tell when\r\n  * CSS animations can be run on the compositor thread vs when they trigger\r\n  * reflow/repaint. The t