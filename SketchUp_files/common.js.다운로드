solid color.$col_blue;\r\n\r\n  &:hover {\r\n    border: 1px solid transparent;\r\n    background-color: color.$col_blue_light;\r\n    color: color.$col_white;\r\n  }\r\n\r\n  &:active {\r\n    border: 1px solid transparent;\r\n    background-color: color.$col_blue_light;\r\n    color: color.$col_white;\r\n  }\r\n}\r\n\r\n.tertiary-action-button {\r\n  background-color: transparent;\r\n  color: color.$col_blue;\r\n\r\n  &:hover {\r\n    border: 1px solid transparent;\r\n    background-color: color.$col_blue_pale;\r\n  }\r\n\r\n  &:active {\r\n    border: 1px solid transparent;\r\n    background-color: color.$col_blue_pale;\r\n  }\r\n}\r\n\r\n.warning-action-button {\r\n  border-color: color.$col_sketchup_orange;\r\n  background-color: color.$col_sketchup_orange;\r\n  color: color.$col_white;\r\n}\r\n\r\n.warning-action-button:hover,\r\n.warning-action-button:active {\r\n  border-color: color.$col_sketchup_red;\r\n  background-color: color.$col_sketchup_red;\r\n}\r\n\r\n.button-disabled {\r\n  background-color: color.$col_gray_3;\r\n  border: 1px solid transparent;\r\n  opacity: 50%;\r\n  color: color.$col_white;\r\n  pointer-events: none;\r\n}\r\n\r\n@mixin button-reset {\r\n  border: none;\r\n  background: none;\r\n  padding: 0;\r\n  cursor: pointer;\r\n}\r\n',"/**\r\n * A color palette for the Trimble Modus Design System.\r\n *\r\n * Copyright 2022 Trimble Inc.\r\n */\r\n\r\n// GREEN\r\n$col_green: #1e8a44;\r\n$col_green_light: #4ea646;\r\n$col_green_dark: #006638;\r\n$col_green_pale: #e0eccf;\r\n\r\n// RED\r\n$col_red: #da212c;\r\n$col_red_light: #e86363;\r\n$col_red_dark: #ab1f26;\r\n$col_red_pale: #fbd4d7;\r\n\r\n// YELLOW\r\n$col_yellow: #fbad26;\r\n$col_yellow_light: #fec157;\r\n$col_yellow_dark: #e49325;\r\n$col_yellow_pale: #fff5e4;\r\n\r\n// BLUE\r\n$col_blue: #0063a3;\r\n$col_blue_mid: #005f9e;\r\n$col_blue_light: #217cbb;\r\n$col_blue_dark: #0e416c;\r\n$col_blue_pale: #dcedf9;\r\n\r\n// NEUTRAL\r\n$col_white: #ffffff;\r\n\r\n// Off-white alternatives.\r\n$col_gray_light: #f1f1f6;\r\n$col_gray_ipad: #ebebeb;\r\n\r\n// Gray ordinal scale.\r\n$col_gray_0: #e0e1e9;\r\n$col_gray_1: #cbcdd6;\r\n$col_gray_2: #b7b9c3;\r\n$col_gray_3: #a3a6b1;\r\n$col_gray_4: #90939f;\r\n$col_gray_5: #7d808d;\r\n$col_gray_6: #6a6e79;\r\n$col_gray_7: #585c65;\r\n$col_gray_8: #464b52;\r\n$col_gray_9: #353a40;\r\n$col_gray_10: #171c1e;\r\n\r\n$col_typography_body: #363545;\r\n\r\n$col_black: #000000;\r\n\r\n// Primary Trimble brand colors.\r\n$col_trimble_blue_dark: #004f83;\r\n$col_trimble_blue: $col_blue;\r\n\r\n$col_trimble_yellow: $col_yellow;\r\n$col_trimble_gray: #252a2e;\r\n\r\n// Brand accents where dark green and dark red are unavoidable.\r\n$col_trimble_green: #349c44;\r\n$col_trimble_red: #b44e2a;\r\n","/**\r\n * A color palette for the Sketchup brand.\r\n *\r\n * Copyright 2022 Trimble Inc.\r\n */\r\n\r\n// Non-Modus Sketchup brand colors.\r\n$col_blue_electric: #009ad9;\r\n$col_teal: #50e3c2;\r\n$col_markup: #e91895;\r\n$col_sketchup_red: #ff0404;\r\n$col_sketchup_orange: #ff5500;\r\n$col_green_lime: #d9eed4;\r\n","// Copyright 2018 - 2020 Trimble Inc. All Rights Reserved.\r\n\r\n@import 'constants';\r\n@import 'color';\r\n\r\n// Replaces Compass appearance.\r\n@mixin appearance($appearance) {\r\n  -moz-appearance: $appearance;\r\n  -webkit-appearance: $appearance;\r\n  appearance: $appearance;\r\n}\r\n\r\n//Six standardized text styles to be used everywhere\r\n\r\n//Top page headers on home page / modals\r\n@mixin h1-text {\r\n  color: $col_blue;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  letter-spacing: 1px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n//Title on cards, folders, projects\r\n@mixin h2-text {\r\n  color: $col_gray_10;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.85px;\r\n}\r\n\r\n//Panels header\r\n@mixin h3-text {\r\n  color: $col_trimble_blue;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Section header, accordions\r\n@mixin h4-text {\r\n  color: $col_gray_10;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Sub header\r\n@mixin h5-text {\r\n  color: $col_gray_9;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Everywhere else\r\n@mixin standard-text {\r\n  color: $col_gray_9;\r\n  font-size: 9pt;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.modus-text {\r\n  @include standard-text();\r\n\r\n  h1 {\r\n    @include h1-text();\r\n  }\r\n\r\n  h2 {\r\n    @include h2-text();\r\n  }\r\n\r\n  h3 {\r\n    @include h3-text();\r\n  }\r\n\r\n  h4 {\r\n    @include h4-text();\r\n  }\r\n\r\n  h5 {\r\n    @include h5-text();\r\n  }\r\n}\r\n\r\n@mixin active-input-text {\r\n  font-weight: normal;\r\n  font-size: 12px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_black;\r\n}\r\n\r\n@mixin label-badge-text {\r\n  font-weight: bold;\r\n  font-size: 10px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_gray_6;\r\n}\r\n\r\n@mixin modus-input-box($active-sel, $invalid-sel, $disabled-sel) {\r\n  border-bottom: 1px solid $col_gray_6;\r\n  border-radius: 2px;\r\n  border: 1px solid $col_gray_0;\r\n  outline: 0;\r\n  padding-top: 1px;\r\n  padding-bottom: 1px;\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n\r\n  @include active-input-text;\r\n\r\n  &::placeholder {\r\n    color: $col_gray_2;\r\n    opacity: 1;\r\n  }\r\n\r\n  &:focus,\r\n  &#{$active-sel} {\r\n    border-bottom: 2px solid $col_blue_light;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$invalid-sel} {\r\n    border-bottom: 2px solid $col_red;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$disabled-sel} {\r\n    background-color: $col_gray_0;\r\n  }\r\n}\r\n\r\n// Standard box shadow that is offset to right and down.\r\n@mixin box-shadow-right-down {\r\n  box-shadow: 2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset to left and down.\r\n@mixin box-shadow-left-down {\r\n  box-shadow: -2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard 