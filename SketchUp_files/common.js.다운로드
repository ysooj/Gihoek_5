;\r\n$col_trimble_gray: #252a2e;\r\n\r\n// Brand accents where dark green and dark red are unavoidable.\r\n$col_trimble_green: #349c44;\r\n$col_trimble_red: #b44e2a;\r\n","\r\n@import '@sass/color';\r\n@import '@sass/mixins';\r\n@import '@sass/shadow';\r\n\r\n.container {\r\n  @include modus-input-box('.active', '.invalid', '.disabled');\r\n  background-color: $col_white;\r\n  color: $col_typography_body;\r\n  height: 100%;\r\n\r\n  box-sizing: border-box;\r\n\r\n  &:first-child {\r\n    margin-top: 0;\r\n  }\r\n\r\n  &:last-child {\r\n    margin-bottom: 0;\r\n  }\r\n}\r\n\r\n.selector {\r\n  align-items: center;\r\n  cursor: pointer;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  height: 100%;\r\n  position: relative;\r\n}\r\n\r\n.disabled .selector {\r\n  cursor: unset;\r\n}\r\n\r\n.chevron {\r\n  pointer-events: none;\r\n  flex-shrink: 0;\r\n  height: 24px;\r\n  width: 24px;\r\n}\r\n\r\n.options-float {\r\n  position: fixed;\r\n}\r\n\r\n.options-sticky {\r\n  position: sticky;\r\n\r\n  // It looks like padding of the parent elements impact sticky?\r\n  margin-top: 2px;\r\n  margin-left: -8px;\r\n}\r\n\r\n.borderless {\r\n  border: none;\r\n  background: none;\r\n  padding-right: 0px;\r\n}\r\n\r\n.floating-pane {\r\n  // NOTE: this shadow causes the font color to be slightly different than the selected option\r\n  @include shadow_south;\r\n  @include user-select(none);\r\n\r\n  background-color: $col_white;\r\n  overflow-y: auto;\r\n  z-index: 1;\r\n}\r\n","// Copyright 2018 - 2020 Trimble Inc. All Rights Reserved.\r\n\r\n@import '../color/index';\r\n\r\n// TODO (brooks): Decide whether shadows will be used at all. If so, define\r\n// cardinal directions for drop shadows. Currently, only one \"elevation\" is\r\n// used for drop shadows, with only the direction varying.\r\n// Ordinal scales a la Google's Material Design Lite implementation would be\r\n// useful if we decideded that we would like to have a notion of elevation\r\n// in the UI.\r\n\r\n$