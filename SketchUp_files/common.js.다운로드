font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Sub header\r\n@mixin h5-text {\r\n  color: $col_gray_9;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Everywhere else\r\n@mixin standard-text {\r\n  color: $col_gray_9;\r\n  font-size: 9pt;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.modus-text {\r\n  @include standard-text();\r\n\r\n  h1 {\r\n    @include h1-text();\r\n  }\r\n\r\n  h2 {\r\n    @include h2-text();\r\n  }\r\n\r\n  h3 {\r\n    @include h3-text();\r\n  }\r\n\r\n  h4 {\r\n    @include h4-text();\r\n  }\r\n\r\n  h5 {\r\n    @include h5-text();\r\n  }\r\n}\r\n\r\n@mixin active-input-text {\r\n  font-weight: normal;\r\n  font-size: 12px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_black;\r\n}\r\n\r\n@mixin label-badge-text {\r\n  font-weight: bold;\r\n  font-size: 10px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_gray_6;\r\n}\r\n\r\n@mixin modus-input-box($active-sel, $invalid-sel, $disabled-sel) {\r\n  border-bottom: 1px solid $col_gray_6;\r\n  border-radius: 2px;\r\n  border: 1px solid $col_gray_0;\r\n  outline: 0;\r\n  padding-top: 1px;\r\n  padding-bottom: 1px;\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n\r\n  @include active-input-text;\r\n\r\n  &::placeholder {\r\n    color: $col_gray_2;\r\n    opacity: 1;\r\n  }\r\n\r\n  &:focus,\r\n  &#{$active-sel} {\r\n    border-bottom: 2px solid $col_blue_light;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$invalid-sel} {\r\n    border-bottom: 2px solid $col_red;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$disabled-sel} {\r\n    background-color: $col_gray_0;\r\n  }\r\n}\r\n\r\n// Standard box shadow that is offset to right and down.\r\n@mixin box-shadow-right-down {\r\n  box-shadow: 2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset to left and down.\r\n@mixin box-shadow-left-down {\r\n  box-shadow: -2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset down only.\r\n@mixin box-shadow-down {\r\n  box-shadow: 2px 2px 5px 0 $drop-shadow-color;\r\n}\r\n\r\n// Vertically centers an element.\r\n// http://codepen.io/sebastianekstrom/pen/kzEhe\r\n@mixin vertical-align($position: relative) {\r\n  position: $position;\r\n  top: 50%;\r\n  -webkit-transform: translateY(-50%);\r\n  -ms-transform: translateY(-50%);\r\n  transform: translateY(-50%);\r\n}\r\n\r\n// Defines the border we use as a hover highlight effect.\r\n@mixin hover-higlight-borders {\r\n  border: 1px solid black;\r\n}\r\n\r\n// Adds a border transition to be used in conjunction with\r\n// hover-higlight-borders.\r\n@mixin hover-higlight-transition {\r\n  @include transition(border 200ms ease);\r\n}\r\n\r\n// This is a helper for hover-higlight-borders. If adding a hover border will\r\n// increase the overall height of an element (i.e. it doesn't have any borders\r\n// normally), we can use these fake borders that blend in to the background\r\n// color so that adding a hover border won't cause height changes.\r\n@mixin hover-higlight-decoy-borders($color) {\r\n  border: 1px solid $color;\r\n}\r\n\r\n@mixin non-draggable {\r\n  user-drag: none;\r\n  -webkit-user-drag: none;\r\n}\r\n\r\n@mixin default-border {\r\n  border: 1px solid $col_gray_2;\r\n}\r\n\r\n// Replaces Compass input-placeholder.\r\n@mixin input-placeholder {\r\n  &:-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &:-ms-input-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-webkit-input-placeholder {\r\n    @content;\r\n  }\r\n}\r\n\r\n// Replaces Compass opacity.\r\n@mixin opacity($opacity) {\r\n  @if $opacity == 1 {\r\n    filter: unquote('progid:DXImageTransform.Microsoft.Alpha(enabled=false)');\r\n  } @else {\r\n    filter: unquote(\r\n      'progid:DXImageTransform.Microsoft.Alpha(Opacity=#{round($opacity * 100)})'\r\n    );\r\n  }\r\n\r\n  opacity: $opacity;\r\n}\r\n\r\n@mixin spin {\r\n  animation: spin 2s linear infinite;\r\n}\r\n\r\n// Replaces Compass transform.\r\n// Note that this does not support 3D transforms like the compass rule.\r\n@mixin transform($transform) {\r\n  -moz-transform: $transform;\r\n  -ms-transform: $transform;\r\n  -webkit-transform: $transform;\r\n  transform: $transform;\r\n}\r\n\r\n// Replaces Compass transition.\r\n@mixin transition($transition) {\r\n  @if nth($transition, 1) == transform {\r\n    -moz-transition: #{'-moz-' + $transition};\r\n    -o-transition: #{'-o-' + $transition};\r\n    -webkit-transition: #{'-webkit-' + $transition};\r\n  } @else {\r\n    -moz-transition: $transition;\r\n    -o-transition: $transition;\r\n    -webkit-transition: $transition;\r\n  }\r\n  transition: $transition;\r\n}\r\n\r\n// Replaces Compass user-select.\r\n@mixin user-select($select) {\r\n  -moz-user-select: #{'-moz-' + $select};\r\n  -ms-user-select: $select;\r\n  -webkit-user-select: $select;\r\n  user-select: $select;\r\n}\r\n\r\n@mixin disabled-filter {\r\n  // Universal icon color filter for $col_gray_4 (#90939f)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(64%) sepia(19%) saturate(174%)\r\n    hue-rotate(191deg) brightness(89%) contrast(85%);\r\n}\r\n\r\n@mixin hover-filter {\r\n  // Universal icon color filter for $col_blue_electric (#009ad9)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(66%) sepia(83%) saturate(5968%)\r\n    hue-rotate(171deg) brightness(97%) contrast(101%);\r\n}\r\n\r\n@mixin blue-filter {\r\n  // Universal icon color filter for $col_blue || $col_trimble_blue (#0063A3)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(17%) sepia(42%) saturate(7267%)\r\n    hue-rotate(190deg) brightness(95%) contrast(101%);\r\n}\r\n\r\n@mixin no_scrollbar {\r\n  // Disables / hides a scrollbar in a container where one would appear\r\n  scrollbar-width: none;\r\n  &::