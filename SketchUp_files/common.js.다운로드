appearance: $appearance;\r\n  -webkit-appearance: $appearance;\r\n  appearance: $appearance;\r\n}\r\n\r\n//Six standardized text styles to be used everywhere\r\n\r\n//Top page headers on home page / modals\r\n@mixin h1-text {\r\n  color: $col_blue;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  letter-spacing: 1px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n//Title on cards, folders, projects\r\n@mixin h2-text {\r\n  color: $col_gray_10;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.85px;\r\n}\r\n\r\n//Panels header\r\n@mixin h3-text {\r\n  color: $col_trimble_blue;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Section header, accordions\r\n@mixin h4-text {\r\n  color: $col_gray_10;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Sub header\r\n@mixin h5-text {\r\n  color: $col_gray_9;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Everywhere else\r\n@mixin standard-text {\r\n  color: $col_gray_9;\r\n  font-size: 9pt;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.modus-text {\r\n  @include standard-text();\r\n\r\n  h1 {\r\n    @include h1-text();\r\n  }\r\n\r\n  h2 {\r\n    @include h2-text();\r\n  }\r\n\r\n  h3 {\r\n    @include h3-text();\r\n  }\r\n\r\n  h4 {\r\n    @include h4-text();\r\n  }\r\n\r\n  h5 {\r\n    @include h5-text();\r\n  }\r\n}\r\n\r\n@mixin active-input-text {\r\n  font-weight: normal;\r\n  font-size: 12px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_black;\r\n}\r\n\r\n@mixin label-badge-text {\r\n  font-weight: bold;\r\n  font-size: 10px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_gray_6;\r\n}\r\n\r\n@mixin modus-input-box($active-sel, $invalid-sel, $disabled-sel) {\r\n  border-bottom: 1px solid $col_gray_6;\r\n  border-radius: 2px;\r\n  border: 1px solid $col_gray_0;\r\n  outline: 0;\r\n  padding-top: 1px;\r\n  padding-bottom: 1px;\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n\r\n  @incl