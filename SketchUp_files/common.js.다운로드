ix standardized text styles to be used everywhere\r\n\r\n//Top page headers on home page / modals\r\n@mixin h1-text {\r\n  color: $col_blue;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  letter-spacing: 1px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n//Title on cards, folders, projects\r\n@mixin h2-text {\r\n  color: $col_gray_10;\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.85px;\r\n}\r\n\r\n//Panels header\r\n@mixin h3-text {\r\n  color: $col_trimble_blue;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Section header, accordions\r\n@mixin h4-text {\r\n  color: $col_gray_10;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Sub header\r\n@mixin h5-text {\r\n  color: $col_gray_9;\r\n  font-size: 12px;\r\n  font-weight: bold;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n//Everywhere else\r\n@mixin standard-text {\r\n  color: $col_gray_9;\r\n  font-size: 9pt;\r\n  letter-spacing: 0.75px;\r\n}\r\n\r\n.modus-text {\r\n  @include standard-text();\r\n\r\n  h1 {\r\n    @include h1-text();\r\n  }\r\n\r\n  h2 {\r\n    @include h2-text();\r\n  }\r\n\r\n  h3 {\r\n    @include h3-text();\r\n  }\r\n\r\n  h4 {\r\n    @include h4-text();\r\n  }\r\n\r\n  h5 {\r\n    @include h5-text();\r\n  }\r\n}\r\n\r\n@mixin active-input-text {\r\n  font-weight: normal;\r\n  font-size: 12px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_black;\r\n}\r\n\r\n@mixin label-badge-text {\r\n  font-weight: bold;\r\n  font-size: 10px;\r\n  letter-spacing: 0.75px;\r\n  color: $col_gray_6;\r\n}\r\n\r\n@mixin modus-input-box($active-sel, $invalid-sel, $disabled-sel) {\r\n  border-bottom: 1px solid $col_gray_6;\r\n  border-radius: 2px;\r\n  border: 1px solid $col_gray_0;\r\n  outline: 0;\r\n  padding-top: 1px;\r\n  padding-bottom: 1px;\r\n  padding-left: 8px;\r\n  padding-right: 8px;\r\n\r\n  @include active-input-text;\r\n\r\n  &::placeholder {\r\n    color: $col_gray_2;\r\n    opacity: 1;\r\n  }\r\n\r\n  &:focus,\r\n  &#{$active-sel} {\r\n    border-bottom: 2px solid $col_blue_light;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$invalid-sel} {\r\n    border-bottom: 2px solid $col_red;\r\n    padding-bottom: 0px;\r\n  }\r\n\r\n  &#{$disabled-sel} {\r\n    background-color: $col_gray_0;\r\n  }\r\n}\r\n\r\n// Standard box shadow that is offset to right and down.\r\n@mixin box-shadow-right-down {\r\n  box-shadow: 2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset to left and down.\r\n@mixin box-shadow-left-down {\r\n  box-shadow: -2px 2px 5px 0px $drop-shadow-color;\r\n}\r\n\r\n// Standard box shadow that is offset down only.\r\n@mixin box-shadow-down {\r\n  box-shadow: 2px 2px 5px 0 $drop-shadow-color;\r\n}\r\n\r\n// Vertically centers an element.\r\n// http://codepen.io/sebastianekstrom/pen/kzEhe\r\n@mixin vertical-align($position: relative) {\r\n  position: $position;\r\n  top: 50%;\r\n  -webkit-transform: translateY(-50%);\r\n  -ms-transform: translateY(-50%);\r\n  transform: translateY(-50%);\r\n}\r\n\r\n// Defines the border we use as a hover highlight effect.\r\n@mixin hover-higlight-borders {\r\n  border: 1px solid black;\r\n}\r\n\r\n// Adds a border transition to be used in conjunction with\r\n// hover-higlight-borders.\r\n@mixin hover-higlight-transition {\r\n  @include transition(border 200ms ease);\r\n}\r\n\r\n// This is a helper for hover-higlight-borders. If adding a hover border will\r\n// increase the overall height of an element (i.e. it doesn't have any borders\r\n// normally), we can use these fake borders that blend in to the background\r\n// color so that adding a hover border won't cause height changes.\r\n@mixin hover-higlight-decoy-borders($color) {\r\n  border: 1px solid $color;\r\n}\r\n\r\n@mixin non-draggable {\r\n  user-drag: none;\r\n  -webkit-user-drag: none;\r\n}\r\n\r\n@mixin default-border {\r\n  border: 1px solid $col_gray_2;\r\n}\r\n\r\n// Replaces Compass input-placeholder.\r\n@mixin input-placeholder {\r\n  &:-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-moz-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &:-ms-input-placeholder {\r\n    @content;\r\n  }\r\n\r\n  &::-webkit-input-placeholder {\r\n    @content;\r\n  }\r\n}\r\n\r\n// Replaces Compass opacity.\r\n@mixin opacity($opacity) {\r\n  @if $opacity == 1 {\r\n    filter: unquote('progid:DXImageTransform.Microsoft.Alpha(enabled=false)');\r\n  } @else {\r\n    filter: unquote(\r\n      'progid:DXImageTransform.Microsoft.Alpha(Opacity=#{round($opacity * 100)})'\r\n    );\r\n  }\r\n\r\n  opacity: $opacity;\r\n}\r\n\r\n@mixin spin {\r\n  animation: spin 2s linear infinite;\r\n}\r\n\r\n// Replaces Compass transform.\r\n// Note that this does not support 3D transforms like the compass rule.\r\n@mixin transform($transform) {\r\n  -moz-transform: $transform;\r\n  -ms-transform: $transform;\r\n  -webkit-transform: $transform;\r\n  transform: $transform;\r\n}\r\n\r\n// Replaces Compass transition.\r\n@mixin transition($transition) {\r\n  @if nth($transition, 1) == transform {\r\n    -moz-transition: #{'-moz-' + $transition};\r\n    -o-transition: #{'-o-' + $transition};\r\n    -webkit-transition: #{'-webkit-' + $transition};\r\n  } @else {\r\n    -moz-transition: $transition;\r\n    -o-transition: $transition;\r\n    -webkit-transition: $transition;\r\n  }\r\n  transition: $transition;\r\n}\r\n\r\n// Replaces Compass user-select.\r\n@mixin user-select($select) {\r\n  -moz-user-select: #{'-moz-' + $select};\r\n  -ms-user-select: $select;\r\n  -webkit-user-select: $select;\r\n  user-select: $select;\r\n}\r\n\r\n@mixin disabled-filter {\r\n  // Universal icon color filter for $col_gray_4 (#90939f)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(64%) sepia(19%) saturate(174%)\r\n    hue-rotate(191deg) brightness(89%) contrast(85%);\r\n}\r\n\r\n@mixin hover-filter {\r\n  // Universal icon color filter for $col_blue_electric (#009ad9)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(66%) sepia(83%) saturate(5968%)\r\n    hue-rotate(171deg) brightness(97%) contrast(101%);\r\n}\r\n\r\n@mixin blue-filter {\r\n  // Universal icon color filter for $col_blue || $col_trimble_blue (#0063A3)\r\n  // Code generated from https://codepen.io/sosuke/pen/Pjoqqp\r\n  filter: brightness(0) saturate(100%) invert(17%) sepia(42%) saturate(7267%)\r\n    hue-rotate(190deg) brightness(95%) contrast(101%);\r\n}\r\n\r\n@mixin no_scrollbar {\r\n  // Disables / hides a scrollbar in a container where one would appear\r\n  scrollbar-width: none;\r\n  &::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n}\r\n\r\n@mixin multiline-text-overflow-ellipsis($lines) {\r\n  // Normally webkit prefixes would be of concern but these are actually widely supported.\r\n  // https://caniuse.com/?search=line-clamp\r\n\r\n  display: block; /* Fallback for non-webkit */\r\n  display: -webkit-box;\r\n  line-clamp: $lines;\r\n  -webkit-line-clamp: $lines;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  word-break: break-word;\r\n  white-space: normal;\r\n}\r\n\r\n@mixin linkshare-button-base {\r\n  // Common styles for buttons in the link sharing dialog.\r\n  height: 44px;\r\n  padding: 0 12px;\r\n  border-radius: 4px;\r\n  font-family: 'Open Sans';\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  line-height: 150%;\r\n  user-select: none;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  box-sizing: border-box;\r\n\r\n  width: 120px;\r\n  text-align: center;\r\n}\r\n\r\n// Takes a color and applies an opacity value to it\r\n// Returns a rgba() color string\r\n// @param {string} $color - The original color (hex, rgb, or rgba)\r\n// @param {number} $opacity - Opacity value between 0 and 1\r\n// @return {string} - rgba color with applied opacity\r\n@function apply-opacity($color, $opacity) {\r\n  @return rgba($color, $opacity);\r\n}\r\n","/**\r\n * A color palette for the Trimble Modus Design System.\r\n *\r\n * Copyright 2022 Trimble Inc.\r\n */\r\n\r\n// GREEN\r\n$col_green: #1e8a44;\r\n$col_green_light: #4ea646;\r\n$col_green_dark: #006638;\r\n$col_green_pale: #e0eccf;\r\n\r\n// RED\r\n$col_red: #da212c;\r\n$col_red_light: #e86363;\r\n$col_red_dark: #ab1f26;\r\n$col_red_pale: #fbd4d7;\r\n\r\n// YELLOW\r\n$col_yellow: #fbad26;\r\n$col_yellow_light: #fec157;\r\n$col_yellow_dark: #e49325;\r\n$col_yellow_pale: #fff5e4;\r\n\r\n// BLUE\r\n$col_blue: #0063a3;\r\n$col_blue_mid: #005f9e;\r\n$col_blue_light: #217cbb;\r\n$col_blue_dark: #0e416c;\r\n$col_blue_pale: #dcedf9;\r\n\r\n// NEUTRAL\r\n$col_white: #ffffff;\r\n\r\n// Off-white alternatives.\r\n$col_gray_light: #f1f1f6;\r\n$col_gray_ipad: #ebebeb;\r\n\r\n// Gray ordinal scale.\r\n$col_gray_0: #e0e1e9;\r\n$col_gray_1: #cbcdd6;\r\n$col_gray_2: #b7b9c3;\r\n$col_gray_3: #a3a6b1;\r\n$col_gray_4: #90939f;\r\n$col_gray_5: #7d808d;\r\n$col_gray_6: #6a6e79;\r\n$col_gray_7: #585c65;\r\n$col_gray_8: #464b52;\r\n$col_gray_9: #353a40;\r\n$col_gray_10: #171c1e;\r\n\r\n$col_typography_body: #363545;\r\n\r\n$col_black: #000000;\r\n\r\n// Primary Trimble brand colors.\r\n$col_trimble_blue_dark: #004f83;\r\n$col_trimble_blue: $col_blue;\r\n\r\n$col_trimble_yellow: $col_yellow;\r\n$col_trimble_gray: #252a2e;\r\n\r\n// Brand accents where dark green and dark red are unavoidable.\r\n$col_trimble_green: #349c44;\r\n$col_trimble_red: #b44e2a;\r\n","\r\n@use '@sass/color';\r\n@use '@sass/mixins';\r\n@use '@sass/shadow';\r\n@use '@sass/zindex';\r\n\r\n.left-toolbar-container {\r\n  left: 0px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background-color: color.$col_gray_light;\r\n}\r\n\r\n.left-toolbar-shadow {\r\n  @include shadow.shadow_southeast;\r\n}\r\n\r\n.no-overflow {\r\n  overflow: hidden;\r\n}\r\n\r\n.grayed-out {\r\n  opacity: 0.4;\r\n}\r\n\r\n.toolbar-contents {\r\n  display: flex;\r\n  flex-direction: column;\r\n  border-radius: 2px;\r\n}\r\n\r\n.toolbar-scrollable {\r\n  @include mixins.no_scrollbar;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n  // This makes the scrolling snap, keeping the top of the tools\r\n  // aligned with the top of the scroll container.\r\n  scroll-snap-type: y mandatory;\r\n  overflow-y: scroll;\r\n}\r\n\r\n.overflow-scroll-container {\r\n  overflow-y: auto;\r\n}\r\n\r\n.tool-section-separator {\r\n  border-top: 1px solid color.$col_gray_1;\r\n  margin: 8px 4px 1px 4px;\r\n  padding-right: 8px;\r\n}\r\n\r\n.overflow-tools-container {\r\n  @include shadow.shadow_southeast;\r\n  position: fixed;\r\n  width: max-content;\r\n  border-radius: 2px;\r\n  overflow: hidden;\r\n  background-color: color.$col_gray_light;\r\n  user-select: none;\r\n\r\n  .overflow-tools-padding {\r\n    padding: 8px 0px 8px v-bind(overflowToolsPaddingPx);\r\n  }\r\n\r\n  .tool-section-wrapper {\r\n    display: flex;\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    justify-content: flex-start;\r\n\r\n    .draggable-tool {\r\n      padding: 0px v-bind(overflowToolsButtonSidePaddingPx);\r\n    }\r\n  }\r\n  .tool-section-end-padding {\r\n    flex-grow: 1;\r\n  }\r\n}\r\n\r\n.edit-button-container {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding-left: 4px;\r\n  padding-right: 4px;\r\n\r\n  .spacer {\r\n    width: v-bind(spacerWidthPx);\r\n  }\r\n\r\n  .icon {\r\n    width: 28px;\r\n    height: 28px;\r\n    padding: 8px;\r\n  }\r\n\r\n  .edit-button {\r\n    font-family: 'Open Sans', sans-serif;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    font-size: 10px;\r\n    color: color.$col_gray_4;\r\n    background: inherit;\r\n    border: 1px solid color.$col_gray_4;\r\n    border-radius: 10px;\r\n    margin-top: 8px;\r\n    align-self: center;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    margin-bottom: 5px;\r\n\r\n    &:hover {\r\n      background: color.$col_blue_pale;\r\n    }\r\n  }\r\n}\r\n\r\n.show-overflow-button {\r\n  border: none;\r\n  border-radius: 4px;\r\n  padding: 0px;\r\n  cursor: pointer;\r\n  background-color: inherit;\r\n  height: v-bind(unlabeledToolButtonHeightPx);\r\n  &:not(.grayed-out):hover,\r\n  &.active {\r\n    background: color.$col_blue_pale;\r\n  }\r\n\r\n  .icon {\r\n    width: 28px;\r\n    height: 28px;\r\n    padding: 6px;\r\n  }\r\n}\r\n\r\n@media (max-height: 630px) {\r\n  .show-overflow-button .icon {\r\n    width: 23px;\r\n    height: 23px;\r\n    padding: 5px;\r\n  }\r\n}\r\n\r\n.draggable-tool {\r\n  outline: none;\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  justify-content: center;\r\n  align-content: center;\r\n  // Tools will snap to the top of the element (the start in the Y direction) when their container is being scrolled\r\n  scroll-snap-align: start;\r\n}\r\n\r\n.vertically-center-left-toolbar {\r\n  position: fixed;\r\n  left: 6px;\r\n  top: 0px;\r\n  height: calc(100vh - v-bind(totalMarginPx));\r\n  border-radius: 2px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  pointer-events: none;\r\n  margin-top: v-bind(topMarginPx);\r\n  margin-bottom: v-bind(bottomMarginPx);\r\n  z-index: zindex.$z-index-modeling-ui;\r\n\r\n  & > * {\r\n    pointer-events: auto;\r\n  }\r\n\r\n  &.z-index-two {\r\n    z-index: zindex.$z-index-modeling-ui + 2;\r\n  }\r\n}\r\n\r\n.vertically-center-all-tools {\r\n  position: fixed;\r\n  left: 64px;\r\n  top: 0px;\r\n  height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  z-index: zindex.$z-index-modeling-ui;\r\n}\r\n\r\n.remove-recent-tool-dropzone {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100vw;\r\n  height: 100vh;\r\n  z-index: zindex.$z-index-modeling-ui + 1;\r\n}\r\n\r\n.upgrade-trigger {\r\n  opacity: 0.6;\r\n}\r\n\r\n.toolbar-omnibar {\r\n  @include shadow.shadow_southeast;\r\n\r\n  overflow: hidden;\r\n  min-height: v-bind(unlabeledToolButtonHeightPx);\r\n  margin-bottom: v-bind(omnibarMarginPx);\r\n  border-radius: 2px;\r\n}\r\n\r\n.toolbar-omnibar-container {\r\n  left: calc(100% + 16px);\r\n  position: absolute;\r\n  top: v-bind(omnibarContainerTopPx);\r\n}\r\n","// Copyright 2018 - 2020 Trimble Inc. All Rights Reserved.\r\n\r\n@import '../color/index';\r\n\r\n// TODO (brooks): Decide whether shadows will be used at all. If so, define\r\n// cardinal directions for drop shadows. Currently, only one \"elevation\" is\r\n// used for drop shadows, with only the direction varying.\r\n// Ordinal scales a la Google's Material Design Lite implementation would be\r\n// useful if we decideded that we would like to have a notion of elevation\r\n// in the UI.\r\n\r\n$shadow-opacity: 0.2;\r\n\r\n// Standard box shadow that is offset down only.\r\n@mixin shadow_east {\r\n  box-shadow: 3px 1px 5px rgba(0, 0, 0, $shadow-opacity);\r\n}\r\n\r\n// Standard box shadow that is offset to right and down.\r\n@mixin shadow_southeast {\r\n  box-shadow: 2px 2px 5px 0px rgba(0, 0, 0, $shadow-opacity);\r\n}\r\n\r\n// Standard box shadow that is offset down only.\r\n@mixin shadow_south {\r\n  box-shadow: 0 2px 5px 0 rgba(0, 0, 0, $shadow-opacity);\r\n}\r\n\r\n// Standard box shadow that is offset to left and down.\r\n@mixin shadow_southwest {\r\n  box-shadow: -2px 2px 5px 0px rgba(0, 0, 0, $shadow-opacity);\r\n}\r\n\r\n// Standard box shadow that is offset left only.\r\n@mixin shadow_west {\r\n  box-shadow: -5px 0 5px -3px rgba(0, 0, 0, $shadow-opacity);\r\n}\r\n\r\n// Light shadow that simulates AO for interactive elements.\r\n@mixin interactive_shadow {\r\n  box-shadow: 0 0 8px 0 rgba(0, 95, 158, 0.2);\r\n}\r\n\r\n// Hover state for the light shadow that simulates AO for interactive elements.\r\n@mixin interactive_shadow_hover {\r\n  box-shadow: 0 0 8px 0 rgba(0, 95, 158, 0.2), 0 0 4px 0 rgba(0, 95, 158, 0.2);\r\n}\r\n","// Copyright 2016 - 2020 Trimble Inc. All Rights Reserved.\r\n// Author: brooks@sketchup.com (Brooks Mershon)\r\n// Z-index scale.\r\n\r\n$z-index-1: 10; // main canvas i